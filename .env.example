# Optional local configuration; copy to the project root .env and edit locally.
# Never paste a real key into source code, terminal arguments, or shared logs.
# An existing process environment variable takes precedence over this file.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
# V1 candidate model, not frozen or runtime-verified. Reuses the key/base URL above.
SILICONFLOW_LLM_MODEL=Qwen/Qwen3.5-35B-A3B
SILICONFLOW_LLM_TEMPERATURE=0.1
# Optional: leave blank to use the operating system's default input device.
# Run list-input-devices first; set a numeric index here only when selecting another input.
LECTURE_INPUT_DEVICE=
